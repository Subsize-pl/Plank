# Production image for the api service (KAN-26): multi-stage, non-root.
# Build from the repo root: docker build -f api/Dockerfile.prod -t plank-api .
#
# builder  — installs runtime dependencies only (no dev group, no uv cache
#            left behind) into a standalone venv with bytecode precompiled.
# runtime  — slim base; copies only the venv and the application source,
#            runs uvicorn as an unprivileged user.

FROM python:3.13-slim AS builder

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

WORKDIR /app

COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project

FROM python:3.13-slim AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/opt/venv/bin:$PATH"

RUN groupadd --gid 1000 plank \
    && useradd --uid 1000 --gid plank --create-home plank

WORKDIR /app

COPY --from=builder /opt/venv /opt/venv
COPY api ./api

USER plank
EXPOSE 8000

CMD ["uvicorn", "api.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
